# ─────────────────────────────────────────────────────────────────────────────
# Pluto — environment variables
#
# Copy this file to `.env` and fill in every value. Do NOT commit `.env`
# (it is git-ignored). All variables below are required unless noted otherwise.
# ─────────────────────────────────────────────────────────────────────────────

# Auth.js (NextAuth) ----------------------------------------------------------
# Random secret used to sign sessions. Generate one with: npx auth secret
AUTH_SECRET=""
# Google OAuth client (Google Cloud Console → Credentials → OAuth client ID).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Vercel ----------------------------------------------------------------------
# Vercel API token with access to the team that hosts the managed instances.
VERCEL_BEARER_TOKEN=""
# Vercel team id (starts with "team_").
VERCEL_TEAM_ID=""

# AWS S3 (favicon storage) ----------------------------------------------------
# Public base URL of the bucket. The allowed image hostname and the bucket name
# are derived from this value (see next.config.ts and src/server/routers/aws.ts).
# e.g. https://my-bucket.s3.us-east-1.amazonaws.com
NEXT_PUBLIC_S3_BUCKET_URL=""
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# GitHub (managed instance repository) ----------------------------------------
# Token used to read the repo public key and write Actions secrets / dispatch
# workflows. Prefer a fine-grained token scoped to the single repo below.
GITHUB_TOKEN=""
# The repository Pluto deploys instances from.
GITHUB_REPO_OWNER=""
GITHUB_REPO_NAME=""
# Numeric repository id (GET https://api.github.com/repos/<owner>/<name> → "id").
GITHUB_REPO_ID=""

# Credentials webhook ---------------------------------------------------------
# Shared secret used to verify the HMAC signature of incoming credential
# requests (/api/credentials). Use a long random value, e.g. openssl rand -base64 32
CREDENTIALS_SIGNING_SECRET=""

# Mercado Pago ----------------------------------
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_ACCESS_TOKEN=""

# Base URL of the instance. e.g. https://pluto.example.com
INSTANCE_URL=""

# Neon (Database) API Key ---------------------------------------------------------------
NEON_API_KEY=""